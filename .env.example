# 複製為 .env 後填入實際值。.env 不進版控。

# ===== 資料庫（本機與正式環境都需要）=====
DB_NAME=couple_quest_board
DB_USER=cqb
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ===== 本機開發（正式環境請刪除這一段）=====
# 疊加開發用覆寫檔：資料庫開 127.0.0.1:3306、app 開 127.0.0.1:3000、使用開發模式登入
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# 在 IDE 或 ./mvnw spring-boot:run 直接跑 app 時使用
DB_HOST=localhost
DB_PORT=3306
AUTH_MODE=dev
DEV_USER_EMAIL=dev@example.com
# 顯示名稱預設「開發者」；要自訂中文名稱時建議設在 IDE 的環境變數（Spring 讀 .env 時中文可能亂碼）
# DEV_USER_NAME=

# ===== 正式環境（本機開發不需要）=====
# Cloudflare Access（B4 起正式環境必填）
# 團隊網域：Cloudflare Zero Trust 控制台 Settings 中的 Team domain
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# AUD：Zero Trust 控制台中這個 Access 應用程式的 Application Audience (AUD) Tag
# ACCESS_AUD=
# 部署時以 git commit SHA 標記 image
# APP_VERSION=
